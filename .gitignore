# ===============================
__pycache__/
*.pyc
venv/
.venv/

# ===============================
# Docker
# ===============================
# (Dockerfile is committed, but ignore local overrides if any)
docker-compose.override.yml

# ===============================
# Jenkins
# ===============================
# Jenkins workspace & temp files (if ever generated locally)
jenkins_home/

# ===============================

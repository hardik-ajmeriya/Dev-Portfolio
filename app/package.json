{
  "name": "hardik-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node prerender.js",
    "build:client": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "secrets": "wrangler secret put RESEND_API_KEY",
    "db:migrate:local": "wrangler d1 migrations apply hardik-enquiries --local",
    "db:migrate": "wrangler d1 migrations apply hardik-enquiries --remote",
    "seed:local": "wrangler d1 execute hardik-enquiries --local --file=seeds/dev-seed.sql",
    "seed:clear": "wrangler d1 execute hardik-enquiries --local --command \"DELETE FROM enquiries WHERE email LIKE '%@seed.test'\"",
    "cf:login": "wrangler login",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@hookform/resolvers": "^5.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.60.0",
    "three": "^0.169.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.0.4",
    "wrangler": "^4.129.0"
  }
}

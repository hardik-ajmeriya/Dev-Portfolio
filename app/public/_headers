# Cloudflare Workers static-asset headers for the main site.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Parsed by Workers — never served as a public asset.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

  # CSP for the real site. Wider than the coming-soon page because this one
  # actually loads third-party resources:
  #   static.cloudflareinsights.com  Cloudflare Web Analytics beacon
  #   cdn.jsdelivr.net               Devicon technology logos (Tech section)
  #
  # Fonts are NO LONGER third-party — they are self-hosted and served from
  # this origin, so fonts.googleapis.com and fonts.gstatic.com have been
  # removed from style-src and font-src entirely. Fewer origins trusted is
  # strictly better; this also removes the only request that sent a visitor's
  # IP address to Google before they had interacted with anything.
  #
  # manifest-src is listed explicitly. default-src 'none' covers every
  # directive that is not named, and that includes manifest-src — without
  # this line the browser silently refuses to fetch site.webmanifest and the
  # Android install prompt and home-screen icon never appear. It fails
  # quietly, as a console warning rather than a broken page.
  #
  # Note there is no email provider listed in connect-src. The contact form
  # posts same-origin to /api/enquiry, and the Worker talks to Resend from
  # the server — the browser never contacts an email API directly.
  #
  # 'unsafe-inline' appears for style-src ONLY, and it is genuinely required:
  # the site sets inline style attributes at runtime in several places —
  # React style={{...}} props (stagger delays in Hero and Tech), the cursor,
  # magnetic buttons and card tilt writing element.style.transform, and
  # three.js sizing its own canvas. Those are inline styles, which CSP blocks
  # without this. Note the compiled CSS itself is a linked stylesheet, so it
  # is NOT the reason.
  #
  # script-src stays clean — no 'unsafe-inline', no 'unsafe-eval'. That is the
  # directive that actually matters for XSS; inline *styles* are far lower risk.
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# HTML must always revalidate so a deploy is picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Vite fingerprints these filenames with a content hash, so they can be
# cached hard and forever — a new build produces new filenames.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep stable filenames, so cache for a day rather than a year.
/images/*
  Cache-Control: public, max-age=86400

# The resume had no cache policy at all, so it was revalidated on every view.
/DevOps_V1.2.pdf
  Cache-Control: public, max-age=86400

# The 404 page must never be cached as though it were a real page.
/404.html
  Cache-Control: no-store

# Favicons live at fixed, unhashed paths, so they cannot be cached for a year
# the way the fingerprinted /assets/* files are — a future rebrand would never
# reach anyone who had already visited. A day is long enough to avoid
# refetching on every page view and short enough that a change propagates.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-16x16.png
  Cache-Control: public, max-age=86400
/favicon-32x32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/android-chrome-192x192.png
  Cache-Control: public, max-age=86400
/android-chrome-512x512.png
  Cache-Control: public, max-age=86400
/maskable-icon-512x512.png
  Cache-Control: public, max-age=86400

# The manifest is tiny and changes rarely, but must not go stale for a year.
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

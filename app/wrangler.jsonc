{
  // Cloudflare Workers configuration for the main site.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "hardik-portfolio",
  "compatibility_date": "2026-09-01",

  // The Worker script. Handles POST /api/enquiry and delegates everything
  // else to the static assets via the ASSETS binding.
  "main": "worker/index.js",

  "assets": {
    // Vite writes the production build here.
    "directory": "./dist",

    // Exposes the static files to the Worker as env.ASSETS.
    "binding": "ASSETS",

    // Unknown paths serve index.html so client-side anchors keep working.
    "not_found_handling": "single-page-application",

    // Routes that must reach the Worker BEFORE the static asset layer.
    //
    // Without a path listed here, Cloudflare tries to serve a matching file,
    // finds none, and — because not_found_handling is single-page-application
    // — returns dist/index.html instead. The Worker never runs.
    //
    // That is exactly what happened when /admin was missing from this list:
    // visiting /admin served the prerendered portfolio page rather than the
    // admin panel, in local dev and would have in production too.
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },

  // Enquiries are stored here so the /admin panel has something to show.
  // Create it once with:  npx wrangler d1 create hardik-enquiries
  // then paste the returned database_id below. See ADMIN.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hardik-enquiries",
      "database_id": "dd849afc-c69c-4c2b-aa30-fc46270e8a4a",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Only this verified identity may read the admin panel, even if the
    // Cloudflare Access policy is ever widened by mistake. Not a secret.
    "ADMIN_EMAIL": "hardikpt95@gmail.com",

    // Cloudflare Access JWT verification. Both MUST be set or the admin
    // panel refuses every request — it fails closed by design.
    //
    // ACCESS_TEAM_DOMAIN: Zero Trust → Settings → Custom Pages, shown as
    //   "<your-team>.cloudflareaccess.com"
    // ACCESS_AUD: the Application Audience (AUD) tag, on the Access
    //   application's Overview tab. It is what ties a token to THIS app —
    //   without it, a token for any other app in your team would be accepted.
    //
    // See ADMIN.md. Neither is a secret; both are safe in git.
    "ACCESS_TEAM_DOMAIN": "curly-moon-74da.cloudflareaccess.com",
    "ACCESS_AUD": "910c3c3d5eb5c146aaf3e03ed77e4c39bf62b7ce68c51d60f3a97348cc047e05"
  },

  "observability": {
    "enabled": true
  }

  // The secret is NOT stored here. Set it once with:
  //   npx wrangler secret put RESEND_API_KEY
  // For local dev, put it in app/.dev.vars (gitignored).
}

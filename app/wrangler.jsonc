{
  // Cloudflare Workers configuration for the main site.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "hardik-portfolio",
  "compatibility_date": "2026-09-01",

  // The Worker script. Handles POST /api/enquiry and delegates everything
  // else to the static assets via the ASSETS binding.
  "main": "worker/index.js",

  "assets": {
    // Vite writes the production build here.
    "directory": "./dist",

    // Exposes the static files to the Worker as env.ASSETS.
    "binding": "ASSETS",

    // Unknown paths serve index.html so client-side anchors keep working.
    "not_found_handling": "single-page-application",

    // Send every request through the Worker first, so /api/enquiry is
    // reachable. Without this, asset serving would shadow the API route.
    "run_worker_first": ["/api/*"]
  },

  // Enquiries are stored here so the /admin panel has something to show.
  // Create it once with:  npx wrangler d1 create hardik-enquiries
  // then paste the returned database_id below. See ADMIN.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hardik-enquiries",
      "database_id": "dd849afc-c69c-4c2b-aa30-fc46270e8a4a",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Only this address may read the admin panel, even if the Cloudflare
    // Access policy is ever widened by mistake. Not a secret.
    "ADMIN_EMAIL": "hardikpt95@gmail.com"
  },

  "observability": {
    "enabled": true
  }

  // The secret is NOT stored here. Set it once with:
  //   npx wrangler secret put RESEND_API_KEY
  // For local dev, put it in app/.dev.vars (gitignored).
}

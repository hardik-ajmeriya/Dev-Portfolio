# Copy this file to `.env` (in this app/ directory — Vite loads its own
# project root's .env, not one at the repo root) and fill in real values.

# Required. Get one free at https://web3forms.com — it only allows sending
# to your own form, so it's safe to expose in the client bundle.
VITE_WEB3FORMS_ACCESS_KEY=

# Optional. Cloudflare Turnstile site key (https://dash.cloudflare.com/ →
# Turnstile). Leave blank to keep the contact form running without it — the
# widget script only loads and the challenge only renders once this is set.
VITE_TURNSTILE_SITE_KEY=

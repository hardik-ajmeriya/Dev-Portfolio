{
  // Temporary "coming soon" Worker for hardikajmeriya.com.
  //
  // This is deliberately a SEPARATE Worker from the main site
  // (app/wrangler.jsonc). That keeps the unreleased site completely
  // off the public internet — nothing of it is served or bundled here.
  //
  // At launch: detach the domain from this Worker and attach it to
  // `hardik-portfolio`. See DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "hardik-coming-soon",
  "compatibility_date": "2026-09-01",

  "assets": {
    // Only ./public is served, so this config file is never exposed.
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
